<mxfile host="app.diagrams.net">
  <diagram name="Page-1" id="EArly7FZv-D0hExdLsEj">
    <mxGraphModel dx="11275" dy="6125" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\nskinparam padding 8\nskinparam nodesep 50\nskinparam ranksep 70\nhide circle\n\nlegend top right\n  |= Color |= Class Kind |\n  |&lt;#DAE8FC&gt;| Controller |\n  |&lt;#FFFFFF&gt;| Domain Class |\n  |&lt;#D5E8D4&gt;| Interface |\n  |&lt;#FFF2CC&gt;| Pure Fabrication / Implementation |\n  Team: Muhammad Anas (23i-0853), Aazan M. Mustafa (25i-0789)\nendlegend\n\n&#39; ==========================================\n&#39; CONTROLLERS (BLUE) - LOCKED IN TOP ROW\n&#39; ==========================================\nclass AuthController &lt;&lt;Controller&gt;&gt; #DAE8FC {\n  +launchApplication(): void\n  +login(userId: String, password: String): UserRole\n}\n\nclass ClubController &lt;&lt;Controller, High Cohesion&gt;&gt; #DAE8FC {\n  +openClubRegistration(): void\n  +fetchCoefficient(name: String, countryCode: String): double\n  +confirmClubEntry(): int\n  +generateSeedingPots(): List&lt;SeedingPot&gt;\n  +lockPotAllocations(): boolean\n}\n\nclass FixtureController &lt;&lt;Controller&gt;&gt; #DAE8FC {\n  +generateSwissFixtures(): FixtureSchedule\n  +approveSchedule(): FixtureStatus\n  +runComplianceAudit(scheduleId: String): ValidationReport\n  +selectFixture(fixtureId: String): Fixture\n  +requestReschedule(): Fixture\n  +submitNewSchedule(fixtureId: String, newDate: Date, kickOff: DateTime, venueId: String): FixtureStatus\n}\n\nclass MatchdayController &lt;&lt;Controller&gt;&gt; #DAE8FC {\n  +selectFixture(fixtureId: String): Fixture\n  +enterScore(homeGoals: int, awayGoals: int): void\n  +logMatchEvent(minute: int, eventType: EventType, playerId: String): void\n  +submitResult(completionState: String): MatchResult\n  +confirmSubmission(): FixtureStatus\n  +openDisciplinaryPanel(fixtureId: String): List&lt;Player&gt;\n  +recordCard(playerId: String, clubId: String, minute: int, cardType: CardType): PlayerStatus\n}\n\nclass StandingsController &lt;&lt;Controller&gt;&gt; #DAE8FC {\n  +recalculateTable(): List&lt;StandingEntry&gt;\n  +partitionQualificationTiers(): LeagueTable\n}\n\nclass KnockoutController &lt;&lt;Controller&gt;&gt; #DAE8FC {\n  +generatePlayoffPairings(): List&lt;KnockoutTie&gt;\n  +confirmPairings(): int\n  +initializeRound16Tree(): Bracket\n  +lockBracket(): boolean\n}\n\nAuthController -[hidden]r- ClubController\nClubController -[hidden]r- FixtureController\nFixtureController -[hidden]r- MatchdayController\nMatchdayController -[hidden]r- StandingsController\nStandingsController -[hidden]r- KnockoutController\n\n&#39; ==========================================\n&#39; INTERFACES (GREEN)\n&#39; ==========================================\ninterface CoefficientService &lt;&lt;interface, Protected Variations&gt;&gt; #D5E8D4 {\n  +getCoefficient(name: String, countryCode: String): double\n}\n\ninterface FixtureConstraint &lt;&lt;interface, Polymorphism, Protected Variations&gt;&gt; #D5E8D4 {\n  +check(schedule: FixtureSchedule, report: ValidationReport): void\n}\n\ninterface RankingStrategy &lt;&lt;interface, Polymorphism, Protected Variations&gt;&gt; #D5E8D4 {\n  +rank(entries: List&lt;StandingEntry&gt;): void\n}\n\ninterface MatchResultObserver &lt;&lt;interface, Protected Variations&gt;&gt; #D5E8D4 {\n  +onResultConfirmed(result: MatchResult): void\n}\n\ninterface KnockoutTieFactory &lt;&lt;interface, Creator, Protected Variations&gt;&gt; #D5E8D4 {\n  +createTie(seeded: Club, unseeded: Club, stage: KnockoutStage): KnockoutTie\n}\n\n&#39; ==========================================\n&#39; PURE FABRICATIONS &amp; IMPLEMENTATIONS (YELLOW)\n&#39; ==========================================\nclass UserRepository &lt;&lt;Pure Fabrication, Low Coupling&gt;&gt; #FFF2CC {\n  +findById(id: String): UserAccount\n  +save(user: UserAccount): void\n}\n\nclass ClubRepository &lt;&lt;Pure Fabrication, Low Coupling&gt;&gt; #FFF2CC {\n  +findById(id: String): Club\n  +findAssociation(code: String): NationalAssociation\n  +save(club: Club): void\n}\n\nclass FixtureRepository &lt;&lt;Pure Fabrication, Low Coupling&gt;&gt; #FFF2CC {\n  +findById(id: String): Fixture\n  +findVenue(venueId: String): Venue\n  +save(fixture: Fixture): void\n}\n\nclass PasswordHasher &lt;&lt;Pure Fabrication&gt;&gt; #FFF2CC {\n  +hash(password: String): String\n}\n\nclass UEFACoefficientAdapter &lt;&lt;Indirection, Protected Variations&gt;&gt; #FFF2CC {\n  +getCoefficient(name: String, countryCode: String): double\n}\n\nclass SwissFixtureGenerator &lt;&lt;Pure Fabrication, High Cohesion&gt;&gt; #FFF2CC {\n  +generate(pots: List&lt;SeedingPot&gt;, schedule: FixtureSchedule): void\n}\n\nclass ScheduleValidator &lt;&lt;Pure Fabrication&gt;&gt; #FFF2CC {\n  +validate(schedule: FixtureSchedule): ValidationReport\n}\n\nclass CountryProtectionRule &lt;&lt;Polymorphism, Protected Variations&gt;&gt; #FFF2CC {\n  +check(schedule: FixtureSchedule, report: ValidationReport): void\n}\n\nclass ForeignAssociationLimitRule &lt;&lt;Polymorphism, Protected Variations&gt;&gt; #FFF2CC {\n  +check(schedule: FixtureSchedule, report: ValidationReport): void\n}\n\nclass HomeAwayBalanceRule &lt;&lt;Polymorphism, Protected Variations&gt;&gt; #FFF2CC {\n  +check(schedule: FixtureSchedule, report: ValidationReport): void\n}\n\nclass UEFATieBreakerStrategy &lt;&lt;Polymorphism, Protected Variations&gt;&gt; #FFF2CC {\n  +rank(entries: List&lt;StandingEntry&gt;): void\n}\n\nclass MatchResultPublisher &lt;&lt;Indirection, Low Coupling&gt;&gt; #FFF2CC {\n  +subscribe(observer: MatchResultObserver): void\n  +notifyObservers(result: MatchResult): void\n}\n\nclass StandardTieFactory &lt;&lt;Creator, Pure Fabrication&gt;&gt; #FFF2CC {\n  +createTie(seeded: Club, unseeded: Club, stage: KnockoutStage): KnockoutTie\n}\n\n&#39; ==========================================\n&#39; DOMAIN CLASSES (WHITE)\n&#39; ==========================================\nabstract class UserAccount &lt;&lt;Information Expert, Polymorphism&gt;&gt; #FFFFFF {\n  -userId: String\n  -username: String\n  -passwordHash: String\n  -role: UserRole\n  -failedAttempts: int\n  -isLocked: boolean\n  +verifyPassword(hash: String): boolean\n  +recordFailedAttempt(): void\n  +{abstract} getRole(): UserRole\n}\n\nclass TournamentAdmin &lt;&lt;Polymorphism&gt;&gt; #FFFFFF {\n  -department: String\n  +getRole(): UserRole\n}\n\nclass MatchOfficial &lt;&lt;Polymorphism&gt;&gt; #FFFFFF {\n  -officialRole: String\n  +getRole(): UserRole\n}\n\nTournamentAdmin -[hidden]r- MatchOfficial\n\nclass Tournament &lt;&lt;Creator&gt;&gt; #FFFFFF {\n  -tournamentId: String\n  -season: String\n  -format: String\n  -numberOfClubs: int\n  -currentStage: TournamentStage\n  +registerClub(name: String, association: NationalAssociation, coefficient: double): Club\n  +createSeedingPots(): List&lt;SeedingPot&gt;\n  +createSchedule(): FixtureSchedule\n  +createBracket(): Bracket\n  +addTie(tie: KnockoutTie): void\n}\n\nclass NationalAssociation #FFFFFF {\n  -code: String\n  -name: String\n}\n\nclass Club &lt;&lt;Information Expert&gt;&gt; #FFFFFF {\n  -clubId: String\n  -name: String\n  -coefficient: double\n  -isTitleHolder: boolean\n  -registeredOn: Date\n  +getCoefficient(): double\n  +getAssociation(): NationalAssociation\n  +hasMatchWithin(date: Date, hours: int): boolean\n}\n\nclass Venue #FFFFFF {\n  -venueId: String\n  -stadiumName: String\n  -city: String\n  -capacity: int\n}\n\nclass SeedingPot &lt;&lt;Information Expert&gt;&gt; #FFFFFF {\n  -potNumber: int\n  -capacity: int\n  -isLocked: boolean\n  +addClub(club: Club): void\n  +lock(): void\n}\n\nclass FixtureSchedule &lt;&lt;Creator&gt;&gt; #FFFFFF {\n  -scheduleId: String\n  -generatedOn: DateTime\n  -totalFixtures: int\n  -isApproved: boolean\n  +createFixture(home: Club, away: Club, matchday: int): Fixture\n  +approve(): void\n}\n\nclass Fixture &lt;&lt;Information Expert, Creator&gt;&gt; #FFFFFF {\n  -fixtureId: String\n  -matchday: int\n  -kickOff: DateTime\n  -status: FixtureStatus\n  +reschedule(date: Date, kickOff: DateTime, venue: Venue): void\n  +createResult(homeGoals: int, awayGoals: int): MatchResult\n  +setStatus(status: FixtureStatus): void\n}\n\nclass ValidationReport &lt;&lt;Creator, Information Expert&gt;&gt; #FFFFFF {\n  -reportId: String\n  -runOn: DateTime\n  -isCompliant: boolean\n  -violationCount: int\n  +addViolation(type: String, description: String, fixture: Fixture): ConstraintViolation\n  +isCompliant(): boolean\n}\n\nclass ConstraintViolation #FFFFFF {\n  -violationType: String\n  -description: String\n}\n\nclass MatchResult &lt;&lt;Creator&gt;&gt; #FFFFFF {\n  -homeGoals: int\n  -awayGoals: int\n  -isFinal: boolean\n  -recordedAt: DateTime\n  +addEvent(minute: int, eventType: EventType, player: Player): MatchEvent\n  +finalise(): void\n}\n\nclass MatchEvent #FFFFFF {\n  -minute: int\n  -eventType: EventType\n  -description: String\n}\n\nclass Player &lt;&lt;Creator, Information Expert&gt;&gt; #FFFFFF {\n  -playerId: String\n  -name: String\n  -shirtNumber: int\n  -position: String\n  -status: PlayerStatus\n  +addCard(cardType: CardType, minute: int, fixture: Fixture): DisciplinaryRecord\n  +countYellowCards(): int\n  +suspend(): Suspension\n}\n\nclass DisciplinaryRecord #FFFFFF {\n  -recordId: String\n  -cardType: CardType\n  -minute: int\n  -issuedOn: Date\n}\n\nclass Suspension #FFFFFF {\n  -suspensionId: String\n  -reason: String\n  -matchesBanned: int\n  -startMatchday: int\n  -isActive: boolean\n}\n\nclass LeagueTable &lt;&lt;Information Expert&gt;&gt; #FFFFFF {\n  -lastUpdated: DateTime\n  -isFinal: boolean\n  +onResultConfirmed(result: MatchResult): void\n  +applyResult(result: MatchResult): void\n  +sort(strategy: RankingStrategy): void\n  +partitionTiers(): void\n  +getEntriesByRank(from: int, to: int): List&lt;StandingEntry&gt;\n}\n\nclass StandingEntry &lt;&lt;Information Expert&gt;&gt; #FFFFFF {\n  -rank: int\n  -played: int\n  -wins: int\n  -draws: int\n  -losses: int\n  -goalsFor: int\n  -goalsAgainst: int\n  -goalDifference: int\n  -awayGoals: int\n  -awayWins: int\n  -points: int\n  -tier: QualificationTier\n  +update(goalsFor: int, goalsAgainst: int, isAway: boolean): void\n  +setTier(tier: QualificationTier): void\n}\n\nclass TieBreakerRule #FFFFFF {\n  -priority: int\n  -criterion: String\n}\n\nabstract class KnockoutTie &lt;&lt;Polymorphism, Creator&gt;&gt; #FFFFFF {\n  -tieId: String\n  -round: KnockoutStage\n  -seededAggregate: int\n  -unseededAggregate: int\n  -decidedBy: String\n  -bracketSlot: int\n  +{abstract} createLegs(): void\n  +{abstract} getAggregateWinner(): Club\n}\n\nclass TwoLeggedKnockoutTie &lt;&lt;Polymorphism&gt;&gt; #FFFFFF {\n  +createLegs(): void\n  +getAggregateWinner(): Club\n}\n\nclass SingleMatchTie &lt;&lt;Polymorphism&gt;&gt; #FFFFFF {\n  +createLegs(): void\n  +getAggregateWinner(): Club\n}\n\nclass KnockoutLeg #FFFFFF {\n  -legNumber: int\n  -kickOff: DateTime\n  -homeGoals: int\n  -awayGoals: int\n}\n\nclass Bracket &lt;&lt;Information Expert&gt;&gt; #FFFFFF {\n  -bracketId: String\n  -createdOn: DateTime\n  -isLocked: boolean\n  +placeTie(slot: int, tie: KnockoutTie): void\n  +lock(): void\n}\n\n&#39; ==========================================\n&#39; ENUMERATIONS\n&#39; ==========================================\nenum UserRole &lt;&lt;enumeration&gt;&gt; #FFFFFF {\n  ADMIN\n  OFFICIAL\n}\nenum TournamentStage &lt;&lt;enumeration&gt;&gt; #FFFFFF {\n  REGISTRATION\n  LEAGUE_PHASE\n  PLAYOFF\n  ROUND_OF_16\n  QUARTER_FINAL\n  SEMI_FINAL\n  FINAL\n}\nenum FixtureStatus &lt;&lt;enumeration&gt;&gt; #FFFFFF {\n  SCHEDULED\n  RESCHEDULED\n  IN_PROGRESS\n  COMPLETED\n}\nenum EventType &lt;&lt;enumeration&gt;&gt; #FFFFFF {\n  GOAL\n  OWN_GOAL\n  PENALTY_GOAL\n  SUBSTITUTION\n}\nenum PlayerStatus &lt;&lt;enumeration&gt;&gt; #FFFFFF {\n  AVAILABLE\n  SUSPENDED\n}\nenum CardType &lt;&lt;enumeration&gt;&gt; #FFFFFF {\n  YELLOW\n  RED\n}\nenum QualificationTier &lt;&lt;enumeration&gt;&gt; #FFFFFF {\n  DIRECT_R16\n  KNOCKOUT_PLAYOFF\n  ELIMINATED\n}\nenum KnockoutStage &lt;&lt;enumeration&gt;&gt; #FFFFFF {\n  PLAYOFF\n  R16\n  QF\n  SF\n  FINAL\n}\n\nUserRole -[hidden]d- TournamentStage\nTournamentStage -[hidden]d- FixtureStatus\nFixtureStatus -[hidden]d- EventType\nEventType -[hidden]d- PlayerStatus\nPlayerStatus -[hidden]d- CardType\nCardType -[hidden]d- QualificationTier\nQualificationTier -[hidden]d- KnockoutStage\n\n&#39; ==========================================\n&#39; INHERITANCE &amp; INTERFACE REALIZATIONS\n&#39; ==========================================\nUserAccount &lt;|-- TournamentAdmin\nUserAccount &lt;|-- MatchOfficial\nKnockoutTie &lt;|-- TwoLeggedKnockoutTie\nKnockoutTie &lt;|-- SingleMatchTie\n\nCoefficientService &lt;|.. UEFACoefficientAdapter\nFixtureConstraint &lt;|.. CountryProtectionRule\nFixtureConstraint &lt;|.. ForeignAssociationLimitRule\nFixtureConstraint &lt;|.. HomeAwayBalanceRule\nRankingStrategy &lt;|.. UEFATieBreakerStrategy\nMatchResultObserver &lt;|.. LeagueTable\nKnockoutTieFactory &lt;|.. StandardTieFactory\n\n&#39; ==========================================\n&#39; COMPOSITION (FILLED DIAMOND)\n&#39; ==========================================\nFixtureSchedule \&quot;1\&quot; *--&gt; \&quot;144\&quot; Fixture : contains\nMatchResult \&quot;1\&quot; *--&gt; \&quot;0..*\&quot; MatchEvent : includes\nLeagueTable \&quot;1\&quot; *--&gt; \&quot;36\&quot; StandingEntry : ranks\nKnockoutTie \&quot;1\&quot; *--&gt; \&quot;1..2\&quot; KnockoutLeg : consists of\nValidationReport \&quot;1\&quot; *--&gt; \&quot;0..*\&quot; ConstraintViolation : lists\n\n&#39; ==========================================\n&#39; AGGREGATION (HOLLOW DIAMOND)\n&#39; ==========================================\nTournament \&quot;1\&quot; o--&gt; \&quot;36\&quot; Club : involves\nSeedingPot \&quot;0..1\&quot; o--&gt; \&quot;9\&quot; Club : contains\nClub \&quot;1\&quot; o--&gt; \&quot;1..*\&quot; Player : has squad of\n\n&#39; ==========================================\n&#39; DOMAIN ASSOCIATIONS (ROLES AT TARGET END)\n&#39; ==========================================\nTournamentAdmin \&quot;1..*\&quot; --&gt; \&quot;1\&quot; Tournament : manages\nClub \&quot;1..*\&quot; --&gt; \&quot;1\&quot; NationalAssociation : belongs to\nClub \&quot;1..*\&quot; --&gt; \&quot;1\\nhomeVenue\&quot; Venue\nTournament \&quot;1\&quot; --&gt; \&quot;4\&quot; SeedingPot : divides into\nTournament \&quot;1\&quot; --&gt; \&quot;0..1\&quot; FixtureSchedule : has\nFixture \&quot;4\&quot; --&gt; \&quot;1\\nhomeClub\&quot; Club\nFixture \&quot;4\&quot; --&gt; \&quot;1\\nawayClub\&quot; Club\nFixture \&quot;0..*\&quot; --&gt; \&quot;1\\nvenue\&quot; Venue\nValidationReport \&quot;0..*\&quot; --&gt; \&quot;1\&quot; FixtureSchedule : audits\nConstraintViolation \&quot;0..*\&quot; --&gt; \&quot;1\&quot; Fixture : flags\nFixture \&quot;1\&quot; --&gt; \&quot;0..1\&quot; MatchResult : produces\nMatchOfficial \&quot;1\&quot; --&gt; \&quot;0..*\&quot; MatchResult : records\nMatchEvent \&quot;0..*\&quot; --&gt; \&quot;0..1\&quot; Player : involves\nPlayer \&quot;1\&quot; --&gt; \&quot;0..*\&quot; DisciplinaryRecord : receives\nDisciplinaryRecord \&quot;0..*\&quot; --&gt; \&quot;1\\nissuedIn\&quot; Fixture\nMatchOfficial \&quot;1\&quot; --&gt; \&quot;0..*\&quot; DisciplinaryRecord : logs\nDisciplinaryRecord \&quot;1..*\&quot; --&gt; \&quot;0..1\&quot; Suspension : triggers\nPlayer \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Suspension : serves\nTournament \&quot;1\&quot; --&gt; \&quot;1\&quot; LeagueTable : maintains\nStandingEntry \&quot;1\&quot; --&gt; \&quot;1\\nclub\&quot; Club\nLeagueTable \&quot;1\&quot; --&gt; \&quot;1..*\\nsortedBy\&quot; TieBreakerRule\nMatchResult \&quot;0..8\&quot; --&gt; \&quot;2\&quot; StandingEntry : updates\nTournament \&quot;1\&quot; --&gt; \&quot;0..*\&quot; KnockoutTie : stages\nKnockoutTie \&quot;0..*\&quot; --&gt; \&quot;1\\nseededClub\&quot; Club\nKnockoutTie \&quot;0..*\&quot; --&gt; \&quot;1\\nunseededClub\&quot; Club\nKnockoutTie \&quot;0..*\&quot; --&gt; \&quot;0..1\\nwinner\&quot; Club\nTournament \&quot;1\&quot; --&gt; \&quot;0..1\&quot; Bracket : has\nBracket \&quot;0..1\&quot; --&gt; \&quot;8..15\&quot; KnockoutTie : organizes\n\n&#39; ==========================================\n&#39; CONTROLLER &amp; DESIGN ASSOCIATIONS (ROLES AT TARGET END)\n&#39; ==========================================\nAuthController \&quot;1\&quot; --&gt; \&quot;1\\nuserRepo\&quot; UserRepository\nAuthController \&quot;1\&quot; --&gt; \&quot;1\\nhasher\&quot; PasswordHasher\nClubController \&quot;1\&quot; --&gt; \&quot;1\\ntournament\&quot; Tournament\nClubController \&quot;1\&quot; --&gt; \&quot;1\\ncoeffService\&quot; CoefficientService\nClubController \&quot;1\&quot; --&gt; \&quot;1\\nclubRepo\&quot; ClubRepository\nFixtureController \&quot;1\&quot; --&gt; \&quot;1\\ntournament\&quot; Tournament\nFixtureController \&quot;1\&quot; --&gt; \&quot;1\\ngenerator\&quot; SwissFixtureGenerator\nFixtureController \&quot;1\&quot; --&gt; \&quot;1\\nvalidator\&quot; ScheduleValidator\nFixtureController \&quot;1\&quot; --&gt; \&quot;1\\nfixtureRepo\&quot; FixtureRepository\nScheduleValidator \&quot;1\&quot; --&gt; \&quot;1..*\\nrules\&quot; FixtureConstraint\nMatchdayController \&quot;1\&quot; --&gt; \&quot;1\\nfixtureRepo\&quot; FixtureRepository\nMatchdayController \&quot;1\&quot; --&gt; \&quot;1\\npublisher\&quot; MatchResultPublisher\nMatchResultPublisher \&quot;1\&quot; --&gt; \&quot;1..*\\nobservers\&quot; MatchResultObserver\nStandingsController \&quot;1\&quot; --&gt; \&quot;1\\nleagueTable\&quot; LeagueTable\nStandingsController \&quot;1\&quot; --&gt; \&quot;1\\nstrategy\&quot; RankingStrategy\nKnockoutController \&quot;1\&quot; --&gt; \&quot;1\\ntournament\&quot; Tournament\nKnockoutController \&quot;1\&quot; --&gt; \&quot;1\\nleagueTable\&quot; LeagueTable\nKnockoutController \&quot;1\&quot; --&gt; \&quot;1\\ntieFactory\&quot; KnockoutTieFactory\nKnockoutController \&quot;1\&quot; --&gt; \&quot;0..1\\nbracket\&quot; Bracket\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="k_hgnKB5mJ3bribJEIGH-705">
