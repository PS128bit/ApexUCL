        <mxCell id="SD_UC-01-31" value="1 - Controller: AuthController is the first object to receive the system operations of UC-01." style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;spacingLeft=6;spacingRight=4;fontSize=11;verticalAlign=top;" vertex="1" parent="1">
