        </mxCell>
        <mxCell id="SD_UC-01-32" value="2.1 - Pure Fabrication / Low Coupling: UserRepository hides the JDBC user table from the domain." style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;spacingLeft=6;spacingRight=4;fontSize=11;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1051.6" y="260.0" width="230.0" height="56.0" as="geometry" />
        </mxCell>
        <mxCell id="SD_UC-01-33" value="2.3 - Information Expert: UserAccount owns passwordHash, so it verifies the password itself." style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;spacingLeft=6;spacingRight=4;fontSize=11;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1051.6" y="396.0" width="230.0" height="56.0" as="geometry" />
        </mxCell>
        <mxCell id="SD_UC-01-34" value="2.4 - Polymorphism: getRole() is overridden by TournamentAdmin and MatchOfficial." style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;spacingLeft=6;spacingRight=4;fontSize=11;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1051.6" y="502.0" width="230.0" height="56.0" as="geometry" />
        </mxCell>
        <mxCell id="SD_UC-01-35" value="2.5 - Extensions 4a/4b: failed attempt counted; account locks after 3 failures." style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;spacingLeft=6;spacingRight=4;fontSize=11;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1051.6" y="604.0" width="230.0" height="56.0" as="geometry" />
        </mxCell>
